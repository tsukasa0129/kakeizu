// 家系図クエストの API（アカウント・家系図データの同期）。README の「アカウントと同期」を参照。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kakeizu-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [{ "pattern": "api.kakeizu-quest.app", "custom_domain": true }],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kakeizu-db",
      "database_id": "33681c52-29be-4cd0-b65c-f80156b35f2d",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Email Service（Email Sending）。送信元のドメイン kakeizu-quest.app は Email Sending に登録済み。
  "send_email": [{ "name": "EMAIL" }],
  // Workers AI（戸籍の AI 読み取り。画像の書き起こし → DeepSeek で構造化）
  "ai": { "binding": "AI" },
  "vars": {
    "MAIL_FROM": "noreply@kakeizu-quest.app",
    // AI 読み取りに使うモデル。"workers-ai"（Qwen で書き起こし → DeepSeek で構造化）、"@cf/…"（Workers AI のビジョンモデル1回）、
    // "google/…" など（AI Gateway 経由の外部モデル。Unified Billing のクレジットが必要）。カンマ区切りで、失敗したら次を使う。
    // 比較結果は README の「AI 読み取り」
    // 今は Gemini 3.1 Pro（ゼロデータ保持）→ 失敗したら Claude Opus 4.8（ゼロデータ保持）→ Workers AI の順
    "EXTRACT_MODEL": "google/gemini-3.1-pro,anthropic/claude-opus-4.8,workers-ai"
  }
}
