# RevenueCat public SDK keys (Project settings > API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxx

# Supabase Edge Function that turns koseki images into JSON (see supabase/functions/extract-koseki)
# Leave empty to use the built-in demo response.
EXPO_PUBLIC_EXTRACT_URL=https://<project-ref>.supabase.co/functions/v1/extract-koseki
EXPO_PUBLIC_SUPABASE_ANON_KEY=
