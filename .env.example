# RevenueCat public SDK keys (project 「家系図クエスト」). These are client-side keys and ship inside the app.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_BOnGYKRDNQagZZDBFNWzLCxLTdK
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_OdNelrYZGQrrakCiqftazEHLyhd
# Web (Expo web) uses RevenueCat Web Billing, which charges through the connected Stripe account.
# rcb_sb_ = Stripe sandbox (test cards). Swap for the production rcb_ key once Stripe live mode is connected.
EXPO_PUBLIC_REVENUECAT_WEB_KEY=rcb_sb_aGaiDIFGzmGEJAGFxsbbkGIaw
# Test Store key: lets you try purchases in development builds without App Store / Google Play.
# Remove it for release builds (EAS production profile does not set it).
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_ItLKZCOSNarKpoIFaMxqkiiSQoB

# Store listings shown on the web funnel's post-purchase page (/start/success). Set once the app is published.
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=

# Supabase Edge Function that turns koseki images into JSON (see supabase/functions/extract-koseki)
# Leave empty to use the built-in demo response.
EXPO_PUBLIC_EXTRACT_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
