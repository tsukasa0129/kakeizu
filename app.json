{
  "expo": {
    "name": "家系図クエスト",
    "slug": "kakeizu",
    "owner": "tsk-tsk",
    "scheme": [
      "kakeizu",
      "rc-9ac62803d4",
      "rc-31592afba5"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tsukasa0129.kakeizu",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tsukasa0129.kakeizu",
      "adaptiveIcon": {
        "backgroundColor": "#58CC02",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "戸籍謄本などの書類の写真を選んで、家系図に読み込むために使用します。",
          "cameraPermission": "戸籍謄本などの書類を撮影して、家系図に読み込むために使用します。",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c587b4a8-1c27-4b07-b34b-ec4eadd17d81"
      }
    }
  }
}
